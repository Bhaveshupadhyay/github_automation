# Local Environment Configuration Example
# Copy this file to .env and fill in your actual credentials

# 1. Required for AI Code Generation
GEMINI_API_KEY=AIzaSyYourGeminiApiKeyHere
GITHUB_TOKEN=ghp_YourGitHubPersonalAccessTokenHere
GITHUB_REPOSITORY=your-github-username/your-repository-name

# 3. Optional: Slack Notifications
SLACK_BOT_TOKEN=xoxb-YourSlackBotTokenHere
SLACK_CHANNEL_ID=C12345678

# 4. Optional: Telegram Notifications
TELEGRAM_BOT_TOKEN=789123456:AAFdYourTelegramBotToken
TELEGRAM_CHAT_ID=123456789
