{
  "$schema": "../../qa-contract.schema.json",
  "serviceType": "mobile",
  "port": 8081,
  "healthCheckUrl": "/",
  "mobileConfig": {
    "platform": "android",
    "bundleId": "com.company.app",
    "buildOutputPath": "android/app/build/outputs/apk/debug/app-debug.apk"
  },
  "lifecycle": {
    "prepare": "flutter pub get && flutter build apk --debug",
    "start": "flutter run -d web-server --web-port 8081 --web-hostname 0.0.0.0 --target lib/main_qa.dart"
  }
}
